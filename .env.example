PRODUCTIVE_BASE_URL=https://api.productive.io/api/v2
PRODUCTIVE_ORGANIZATION_ID=28136
PRODUCTIVE_TOKEN=replace-with-your-token

# Safety switch for writes. Unset or anything other than "false" = draft-only: every write is
# blocked except creating/editing a comment, and those are always forced to draft:true so nothing
# can ever post live through this server. Set to false to allow full writes (posts included).
PRODUCTIVE_DRAFT_ONLY=true
